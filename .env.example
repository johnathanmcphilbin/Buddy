# Copy this file to .env for local development (with `vercel dev`) and
# set the same variables in the Vercel project dashboard for production.
# Never commit the real .env file.

# Hackatime OAuth (register an app at https://hackatime.hackclub.com)
HACKATIME_CLIENT_ID=your_hackatime_client_id
HACKATIME_CLIENT_SECRET=your_hackatime_client_secret
HACKATIME_REDIRECT_URI=https://buddy.hackclub.com/auth/hackclub/callback
HACKATIME_BASE_URL=https://hackatime.hackclub.com

# Used to sign the session cookie (any long random string). Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# Airtable (personal access token scoped to just this base:
# data.records:read, data.records:write, schema.bases:read)
AIRTABLE_TOKEN=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Resend (transactional email for submission review notifications)
RESEND_API_KEY=your_resend_api_key
# Until a domain is verified in Resend, emails can only be delivered to
# the Resend account's own email address — set this to that address for
# now, and to johnny@hackclub.com once a domain is verified.
REVIEWER_EMAIL=johnathanmcphilbin2@gmail.com

# Server-only Roboflow key. Revoke the previously published key first.
ROBOFLOW_API_KEY=your_new_roboflow_private_api_key

# Shared Redis REST storage for serializing claims across serverless workers.
# Claims fail closed if these are missing. Use a persistent, non-evicting database.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_rest_token

# Maximum upstream inference calls across all visitors per UTC day.
ROBOFLOW_DAILY_LIMIT=10000

# Set true ONLY after both Airtable tables have verified Hackatime User ID
# values on all existing ledger AND spending records (see SECURITY.md).
BITS_ACCOUNT_IDS_MIGRATED=false
